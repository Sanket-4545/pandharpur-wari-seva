MONGODB_URI=
JWT_SECRET=your-secret-key-minimum-32-characters-generate-with-openssl-rand-base64-64
ADMIN_EMAIL=admin@wariportal.org
ADMIN_PASSWORD=your-secure-admin-password

# Upstash Redis (optional, for serverless rate limiting)
# Create free account at https://upstash.com and create a Redis database
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Web Push / VAPID keys
# Generate with: node -e "const w = require('web-push'); console.log(JSON.stringify(w.generateVAPIDKeys()))"
# Or use an existing key pair. NEVER commit the private key.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_EMAIL=mailto:admin@wariportal.org

# Public VAPID key for client-side (NEXT_PUBLIC_ prefix makes it available in browser)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
